{
  "name": "pandasx-examples",
  "private": true,
  "type": "module",
  "description": "Runnable examples of every pandasx feature, using the package published on npm.",
  "scripts": {
    "start": "node run-all.mjs",
    "all": "node run-all.mjs",
    "all:quiet": "node run-all.mjs --quiet",
    "basics": "node run-all.mjs 01 02 03 04",
    "analysis": "node run-all.mjs 05 06 07 08 09 10 11",
    "time": "node run-all.mjs 12 13",
    "io": "node run-all.mjs 14 15 16",
    "visual": "node run-all.mjs 17 18 19",
    "series": "node --no-warnings 01-series.ts",
    "dataframe": "node --no-warnings 02-dataframe.ts",
    "selection": "node --no-warnings 03-selection.ts",
    "missing-data": "node --no-warnings 04-missing-data.ts",
    "computation": "node --no-warnings 05-computation.ts",
    "text": "node --no-warnings 06-text.ts",
    "categories": "node --no-warnings 07-categories.ts",
    "dtypes": "node --no-warnings 08-dtypes.ts",
    "groupby": "node --no-warnings 09-groupby.ts",
    "reshaping": "node --no-warnings 10-reshaping.ts",
    "combining": "node --no-warnings 11-combining.ts",
    "dates": "node --no-warnings 12-dates-and-times.ts",
    "resample": "node --no-warnings 13-resample-and-windows.ts",
    "io:text": "node --no-warnings 14-io-text-formats.ts",
    "io:sql": "node --no-warnings 15-io-sql.ts",
    "io:binary": "node --no-warnings 16-io-binary-formats.ts",
    "plotting": "node --no-warnings 17-plotting.ts",
    "styling": "node --no-warnings 18-styling.ts",
    "display": "node --no-warnings 19-display-options.ts",
    "report": "node --no-warnings 20-sales-report.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node run-all.mjs --quiet",
    "clean": "node -e \"require('node:fs').rmSync('output', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "exceljs": "^4.4.0",
    "h5wasm": "^0.10.3",
    "hyparquet": "^1.31.3",
    "hyparquet-writer": "^0.16.11",
    "pandasx": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
