{
  "name": "node-pandas",
  "version": "0.1.0",
  "description": "pandas-like DataFrame and Series for Node.js, written in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "parity": "node parity/run.mjs"
  },
  "keywords": [
    "dataframe",
    "pandas",
    "series",
    "data-analysis",
    "csv",
    "groupby"
  ],
  "author": "Gabriel Ferrari Tarallo Ferraz <gftf2011@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
