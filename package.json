{
  "name": "pandasx",
  "version": "0.1.4",
  "description": "pandas-like DataFrame and Series for Node.js, written in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "parity": "node parity/run.mjs"
  },
  "keywords": [
    "dataframe",
    "pandas",
    "series",
    "data-analysis",
    "csv",
    "groupby"
  ],
  "author": "Gabriel Ferrari Tarallo Ferraz <gftf2011@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "apache-arrow": "21.2.0",
    "exceljs": "4.4.0",
    "h5wasm": "0.10.3",
    "hyparquet": "1.31.3",
    "hyparquet-writer": "0.16.11",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "hyparquet": "^1.31.0",
    "hyparquet-writer": "^0.16.11",
    "apache-arrow": ">=17",
    "h5wasm": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "hyparquet": {
      "optional": true
    },
    "hyparquet-writer": {
      "optional": true
    },
    "apache-arrow": {
      "optional": true
    },
    "h5wasm": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gftf2011/pandasx.git"
  },
  "homepage": "https://gftf2011.github.io/pandasx/",
  "bugs": {
    "url": "https://github.com/gftf2011/pandasx/issues"
  }
}
